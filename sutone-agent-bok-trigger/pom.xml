<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.sutone.ai</groupId>
        <artifactId>sutone-agent-bok</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>sutone-agent-bok-trigger</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- RocketMQ -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>

        <!-- 系统模块 -->
        <dependency>
            <groupId>cn.sutone.ai</groupId>
            <artifactId>sutone-agent-bok-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.sutone.ai</groupId>
            <artifactId>sutone-agent-bok-types</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.sutone.ai</groupId>
            <artifactId>sutone-agent-bok-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.sutone.ai</groupId>
            <artifactId>sutone-agent-bok-infrastructure</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>sutone-agent-bok-trigger</finalName>
        <plugins>
            <!-- 仅为 EvalTokenCli（评测凭据签发 CLI）提供 `mvn exec:java` 入口。
                 不参与打包，也不影响 Spring Boot 的启动链路。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>

</project>
